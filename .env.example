# PostgreSQL connection string. On Vercel/serverless with Supabase, use the
# "Transaction pooler" string (port 6543, add ?pgbouncer=true) here.
DATABASE_URL="postgresql://user:password@localhost:5432/antrianonline?schema=public"

# Only needed when DATABASE_URL is a pooler (e.g. Supabase). Used solely for
# `prisma migrate` — the app never reads this at runtime. Use the "Direct
# connection" string (port 5432) here.
DIRECT_URL=""

# Pusher (realtime) — https://dashboard.pusher.com
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""

# Public Pusher client config (exposed to the browser)
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# Staff session signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
